# Copy this file to .env and set every path below. All four are required;
# the app fails to start if any is missing.

# ARM9 bootROM dump (boot9.bin or boot9_prot.bin).
BOOT9_PATH=./assets/boot9.bin

# Extracted AGB_FIRM boot logo, produced once via `agbcia footer extract-logo`.
BOOT_LOGO_PATH=./assets/boot_logo.bin

# A donor GBA Virtual Console banner, extracted from a donor CIA's ExeFS.
DONOR_BANNER_PATH=./assets/donor_banner.bin

# A working forwarder/emulator CIA, used for homebrew-mode injections.
EMULATOR_CORE_PATH=./assets/emulator_core.cia

# How long a generated CIA stays downloadable after being built, in seconds.
RESULT_TTL_SECONDS=7200

# How often the expired-result sweep runs, in seconds.
CLEANUP_INTERVAL_SECONDS=600

# Total bytes of generated CIAs kept in memory before the oldest ones are
# evicted, regardless of TTL.
MAX_STORE_BYTES=536870912

HOST=0.0.0.0
PORT=8000
